    APPROX_QUANTILES(hours_to_card, 100)[OFFSET(75)] AS p75,
    APPROX_QUANTILES(hours_to_card, 100)[OFFSET(95)] AS p95,
    APPROX_QUANTILES(hours_to_card, 100)[OFFSET(99)] AS p99,
    APPROX_QUANTILES(hours_to_card, 100)[OFFSET(100)] AS max_hours

FROM diff;

