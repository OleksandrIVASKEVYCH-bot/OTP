from datetime import datetime, timedelta, date
from google.cloud import bigquery


def run_meta_etl(
    account_ids,
    fallback_date_from=None
):

    # 1. Отримуємо існуючу таблицю
    table_ref = ensure_facebook_table()

    # ----------------------------------------
    # 2. Знаходимо максимальну дату в BigQuery
    # ----------------------------------------

    max_date_query = f"""
        SELECT MAX(date) AS max_date
        FROM `{table_ref.project}.{table_ref.dataset_id}.{table_ref.table_id}`
    """

    max_date_result = list(
        bigquery_client.query(max_date_query).result()
    )

    max_date = max_date_result[0].max_date

    # ----------------------------------------
    # 3. Визначаємо дату початку перезавантаження
    # ----------------------------------------

    if max_date is not None:

        reload_from = max_date - timedelta(days=3)

    else:

        if fallback_date_from is None:
            raise ValueError(
                "Table is empty. "
                "Specify fallback_date_from."
            )

        reload_from = datetime.strptime(
            fallback_date_from,
            "%Y-%m-%d"
        ).date()

    reload_to = date.today()

    print()
    print("=" * 60)
    print(f"Max date in BigQuery: {max_date}")
    print(f"Reload period: {reload_from} → {reload_to}")
    print("=" * 60)

    # ----------------------------------------
    # 4. Видаляємо старі дані за refresh window
    # ----------------------------------------

    delete_query = f"""
        DELETE FROM `{table_ref.project}.{table_ref.dataset_id}.{table_ref.table_id}`
        WHERE date BETWEEN @date_from AND @date_to
    """

    delete_job_config = bigquery.QueryJobConfig(
        query_parameters=[
            bigquery.ScalarQueryParameter(
                "date_from",
                "DATE",
                reload_from
            ),
            bigquery.ScalarQueryParameter(
                "date_to",
                "DATE",
                reload_to
            )
        ]
    )

    delete_job = bigquery_client.query(
        delete_query,
        job_config=delete_job_config
    )

    delete_job.result()

    print(
        f"✓ Deleted existing data: "
        f"{reload_from} → {reload_to}"
    )

    # ----------------------------------------
    # 5. Починаємо повторне завантаження
    # ----------------------------------------

    current_date = reload_from
    final_date = reload_to

    while current_date <= final_date:

        date_str = current_date.strftime(
            "%Y-%m-%d"
        )

        print()
        print("=" * 60)
        print(f"Processing: {date_str}")
        print("=" * 60)

        try:

            # 6. Отримуємо Meta за один день
            df_day = load_meta_ads_one_day(
                account_ids=account_ids,
                current_date=date_str
            )

            if df_day.empty:

                print(
                    f"⏹ No Meta data for {date_str}"
                )

            else:

                # 7. Приводимо типи
                df_day = prepare_meta_df(
                    df_day
                )

                print(
                    f"Rows: {len(df_day)}"
                )

                print(
                    f"Accounts: "
                    f"{df_day['account_id'].nunique()}"
                )

                print(
                    f"Campaigns: "
                    f"{df_day['campaign_id'].nunique()}"
                )

                print(
                    f"Adsets: "
                    f"{df_day['adset_id'].nunique()}"
                )

                print(
                    f"Ads: "
                    f"{df_day['ad_id'].nunique()}"
                )

                print(
                    f"Spend: "
                    f"{df_day['spend'].sum():,.2f}"
                )

                # 8. Дозаписуємо у BigQuery
                job_config = bigquery.LoadJobConfig(
                    schema=schema_facebook_stat,
                    write_disposition=(
                        bigquery.WriteDisposition.WRITE_APPEND
                    )
                )

                job = bigquery_client.load_table_from_dataframe(
                    df_day,
                    table_ref,
                    job_config=job_config
                )

                job.result()

                print(
                    f"✓ Uploaded {len(df_day)} rows"
                )

                print(
                    f"✓ Completed: {date_str}"
                )

        except Exception as e:

            print(
                f"❌ ERROR {date_str}"
            )

            print(e)

            raise

        current_date += timedelta(days=1)

    print()
    print("=" * 60)
    print("✓ Meta ETL completed")
    print("=" * 60)

