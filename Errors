SELECT
  event_name,
  COUNT(*) AS events,

  COUNTIF(
    collected_traffic_source.manual_source IS NULL
  ) AS source_null,

  COUNTIF(
    collected_traffic_source.manual_source IS NOT NULL
  ) AS source_not_null,

  ROUND(
    SAFE_DIVIDE(
      COUNTIF(collected_traffic_source.manual_source IS NULL),
      COUNT(*)
    ) * 100,
    2
  ) AS null_percent

FROM `project.dataset.events_*`

WHERE _TABLE_SUFFIX BETWEEN '20260810' AND '20260811'

GROUP BY event_name

ORDER BY events DESC;
