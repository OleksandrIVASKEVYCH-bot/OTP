SELECT
  CASE

    WHEN collected_traffic_source.gclid IS NOT NULL
      THEN 'Google Ads (gclid)'

    WHEN collected_traffic_source.dclid IS NOT NULL
      THEN 'Google Ads (dclid)'

    WHEN collected_traffic_source.manual_source IS NOT NULL
      THEN 'Manual source / UTM'

    ELSE 'No traffic parameters'

  END AS traffic_type,

  COUNT(*) AS sessions,

  ROUND(
    COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (),
    2
  ) AS percent

FROM `project.dataset.events_*`

WHERE _TABLE_SUFFIX BETWEEN '20260810' AND '20260811'
  AND event_name = 'session_start'

GROUP BY 1

ORDER BY sessions DESC;
