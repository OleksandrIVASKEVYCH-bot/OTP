BEGIN
  DECLARE start_date DATE DEFAULT DATE_SUB(CURRENT_DATE('UTC'), INTERVAL 3 DAY);
  DECLARE end_date DATE DEFAULT DATE_SUB(CURRENT_DATE('UTC'), INTERVAL 1 DAY);

  -- Початкове завантаження з 2026-08-01.
  IF NOT EXISTS (
    SELECT 1
    FROM `crested-aquifer-142707.IOV_silver.landing`
    LIMIT 1
  ) THEN
    SET start_date = DATE '2026-08-01';
  END IF;

  BEGIN TRANSACTION;

  DELETE FROM `crested-aquifer-142707.IOV_silver.landing`
  WHERE DATE(event_datetime, 'UTC') BETWEEN start_date AND end_date;

  INSERT INTO `crested-aquifer-142707.IOV_silver.landing` (
    event_datetime,
    user_id,
    page_location,
    click_text,
    click_url,
    click_hostname
  )
  SELECT
    TIMESTAMP_MICROS(e.event_timestamp),
    COALESCE(e.user_id, e.user_pseudo_id),
    (SELECT ANY_VALUE(p.value.string_value)
     FROM UNNEST(e.event_params) p WHERE p.key = 'page_location'),
    (SELECT ANY_VALUE(p.value.string_value)
     FROM UNNEST(e.event_params) p WHERE p.key = 'click_text'),
    (SELECT ANY_VALUE(p.value.string_value)
     FROM UNNEST(e.event_params) p WHERE p.key = 'click_url'),
    (SELECT ANY_VALUE(p.value.string_value)
     FROM UNNEST(e.event_params) p WHERE p.key = 'click_hostname')
  FROM `crested-aquifer-142707.analytics_250473208.events_*` AS e
  WHERE _TABLE_SUFFIX BETWEEN FORMAT_DATE('%Y%m%d', start_date)
                          AND FORMAT_DATE('%Y%m%d', end_date)
    AND e.event_name = 'all_click_site'
    AND DATE(TIMESTAMP_MICROS(e.event_timestamp), 'UTC')
        BETWEEN start_date AND end_date
    AND EXISTS (
      SELECT 1
      FROM UNNEST(e.event_params) p
      WHERE p.key = 'page_location'
        AND p.value.string_value LIKE '%/landing_page/cash-loan/%'
    );

  COMMIT TRANSACTION;
END;
