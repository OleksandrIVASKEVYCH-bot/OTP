Campaign_Creative =
DISTINCT (
    UNION (
        SELECTCOLUMNS (
            'табл1',
            "campaign_creative",
                'табл1'[campaign_name] & "-" & 'табл1'[creative_id]
        ),
        SELECTCOLUMNS (
            'табл2',
            "campaign_creative",
                'табл2'[campaign_name] & "-" & 'табл2'[creative_id]
        ),
        SELECTCOLUMNS (
            'табл3',
            "campaign_creative",
                'табл3'[campaign_name] & "-" & 'табл3'[creative_id]
        )
    )
)
