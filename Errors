BEGIN
  -- Step 1: Declare a variable and calculate the dynamic 3-day lookback threshold based on current table data
  DECLARE lookback_timestamp TIMESTAMP;
  SET lookback_timestamp = (
    SELECT TIMESTAMP_SUB(MAX(event_datetime), INTERVAL 3 DAY) 
    FROM `crested-aquifer-142707.IOV_silver.landing`
  );
  -- Safety Fallback: If the target landing table is brand new/empty, fall back to your start date
  IF lookback_timestamp IS NULL THEN
    SET lookback_timestamp = TIMESTAMP('2026-08-01 00:00:00 UTC');
  END IF;
  -- Step 2: Clear old records within the restream window to keep data completely clean
  DELETE FROM `crested-aquifer-142707.IOV_silver.landing`
  WHERE event_datetime >= lookback_timestamp;
  -- Step 3: Stream and write fresh records beginning precisely from our lookback timestamp
  INSERT INTO `crested-aquifer-142707.IOV_silver.landing` (
    event_datetime,
    user_id,
    page_location,
    click_text,
    click_url,
    click_hostname
  )
  SELECT
      TIMESTAMP_MICROS(event_timestamp) AS event_datetime
      , COALESCE(user_id, user_pseudo_id) AS user_id
      , (
          SELECT value.string_value
          FROM UNNEST(event_params)
          WHERE key = 'page_location'
        ) AS page_location
      , (
          SELECT value.string_value
          FROM UNNEST(event_params)
          WHERE key = 'click_text'
        ) AS click_text
      , (
          SELECT value.string_value
          FROM UNNEST(event_params)
          WHERE key = 'click_url'
        ) AS click_url
      , (
          SELECT value.string_value
          FROM UNNEST(event_params)
          WHERE key = 'click_hostname'
        ) AS click_hostname
  FROM `crested-aquifer-142707.analytics_250473208.events_*`
  WHERE _TABLE_SUFFIX BETWEEN FORMAT_TIMESTAMP('%Y%m%d', lookback_timestamp) AND '20260928'
    AND event_name = 'all_click_site'
    AND TIMESTAMP_MICROS(event_timestamp) >= lookback_timestamp -- Enforces precise lookback boundary
    AND (
          SELECT value.string_value
          FROM UNNEST(event_params)
          WHERE key = 'page_location'
        ) LIKE '%/landing_page/cash-loan/%';
COMMIT;
