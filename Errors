with 
dictionaries_campaign as (
select distinct
  campaign_id
  ,campaign_name
from `google_ads_data.ads_Campaign_5911949898`
where campaign_name like '%azk%' or campaign_name like '%b2s%'
),
dictionary_creatives as (
select distinct
  campaign_id
  ,ad_group_ad_ad_image_ad_image_url as creative_url
  ,ad_group_ad_ad_image_ad_name creative_name
from `google_ads_data.p_ads_Ad_5911949898`
where campaign_id in (select campaign_id from dictionaries_campaign)
)
SELECT
  segments_date as date
  ,case when campaign_name like '%azk%' then 'УкрНафта'
    else 'Назад до школи'end as campaign_name
  ,creative
  ,'google' as source
  -- ,creative_group
  ,segments_device platorm
  ,'android' as os
  ,'UAH' as currency
  ,sum(metrics_impressions) impressions
  ,sum(metrics_clicks) clicks
  ,round(sum(metrics_cost_micros)/1000000,2) as spend
from `google_ads_data.ads_AdStats_5911949898`
left join dictionary_creatives pa using(campaign_id)
right join dictionaries_campaign ac using(campaign_id) 
group by 1,2,3,4,5
