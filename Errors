def load_meta_ads_one_day(
    account_ids,
    current_date
):
    fields = [
        AdsInsights.Field.date_start,
        AdsInsights.Field.account_id,
        AdsInsights.Field.ad_id,
        AdsInsights.Field.ad_name,
        AdsInsights.Field.adset_id,
        AdsInsights.Field.adset_name,
        AdsInsights.Field.campaign_id,
        AdsInsights.Field.campaign_name,
        AdsInsights.Field.clicks,
        AdsInsights.Field.impressions,
        AdsInsights.Field.spend,
        AdsInsights.Field.conversions,
        AdsInsights.Field.actions
    ]

    params = {
        "level": "ad",
        "time_range": {
            "since": current_date,
            "until": current_date
        },
        "time_increment": 1,
        "breakdowns": ["country"],
        "limit": 500
    }

    rows = []

    for account_id in account_ids:

        clean_account_id = str(account_id).replace("act_", "")

        account = AdAccount(
            f"act_{clean_account_id}"
        )

        print(f"  Meta account: {clean_account_id}")

        insights = account.get_insights(
            fields=fields,
            params=params
        )

        for item in insights:

            rows.append({
                "date": item.get("date_start"),
                "account_id": item.get(
                    "account_id",
                    clean_account_id
                ),
                "ad_id": item.get("ad_id"),
                "ad_name": item.get("ad_name"),
                "adset_id": item.get("adset_id"),
                "adset_name": item.get("adset_name"),
                "campaign_id": item.get("campaign_id"),
                "campaign_name": item.get("campaign_name"),
                "clicks": item.get("clicks", 0),
                "impressions": item.get("impressions", 0),
                "spend": item.get("spend", 0),
                "conversions": item.get("conversions", []),
                "actions": item.get("actions", []),
                "country": item.get("country")
            })

    return pd.DataFrame(rows)

def prepare_meta_df(df):

    if df.empty:
        return df

    # DATE
    df["date"] = pd.to_datetime(
        df["date"],
        errors="coerce"
    ).dt.date

    # INTEGER
    integer_columns = [
        "account_id",
        "ad_id",
        "adset_id",
        "campaign_id",
        "clicks",
        "impressions"
    ]

    for col in integer_columns:
        df[col] = pd.to_numeric(
            df[col],
            errors="coerce"
        ).astype("Int64")

    # FLOAT
    df["spend"] = pd.to_numeric(
        df["spend"],
        errors="coerce"
    ).fillna(0.0)

    # STRING
    string_columns = [
        "ad_name",
        "adset_name",
        "campaign_name",
        "country"
    ]

    for col in string_columns:
        df[col] = df[col].astype("string")

    # RECORD / REPEATED
    # Гарантуємо, що тут завжди списки, а не None/NaN
    df["actions"] = df["actions"].apply(
        lambda x: x if isinstance(x, list) else []
    )

    df["conversions"] = df["conversions"].apply(
        lambda x: x if isinstance(x, list) else []
    )

    return df

from datetime import datetime, timedelta


def run_meta_etl(
    account_ids,
    date_from,
    date_to
):

    # Створить таблицю лише якщо її ще немає
    table_ref = ensure_facebook_table()

    current_date = datetime.strptime(
        date_from,
        "%Y-%m-%d"
    )

    final_date = datetime.strptime(
        date_to,
        "%Y-%m-%d"
    )


    while current_date <= final_date:

        date_str = current_date.strftime(
            "%Y-%m-%d"
        )

        print()
        print("=" * 60)
        print(f"Processing: {date_str}")
        print("=" * 60)

        try:

            # 1. Отримуємо дані Meta за конкретний день
            df_day = load_meta_ads_one_day(
                account_ids=account_ids,
                current_date=date_str
            )

            if df_day.empty:

                print(
                    f"⏹ No Meta data for {date_str}"
                )

            else:

                # 2. Приводимо типи
                df_day = prepare_meta_df(
                    df_day
                )

                print(
                    f"Rows: {len(df_day)}"
                )

                print(
                    f"Accounts: "
                    f"{df_day['account_id'].nunique()}"
                )

                print(
                    f"Campaigns: "
                    f"{df_day['campaign_id'].nunique()}"
                )

                print(
                    f"Adsets: "
                    f"{df_day['adset_id'].nunique()}"
                )

                print(
                    f"Ads: "
                    f"{df_day['ad_id'].nunique()}"
                )

                print(
                    f"Spend: "
                    f"{df_day['spend'].sum():,.2f}"
                )

                # 3. Завантажуємо цей день у BigQuery
                job_config = bigquery.LoadJobConfig(
                    schema=schema_facebook_stat,
                    write_disposition=bigquery.WriteDisposition.WRITE_APPEND
                )

                job = bigquery_client.load_table_from_dataframe(
                    df_day,
                    table_ref,
                    job_config=job_config
                )

                job.result()

                print(
                    f"✓ Uploaded {len(df_day)} rows"
                )

                print(
                    f"✓ Completed: {date_str}"
                )

        except Exception as e:

            print(
                f"❌ ERROR {date_str}"
            )

            print(e)

            raise

        current_date += timedelta(days=1)

