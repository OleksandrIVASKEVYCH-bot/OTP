32. Підсумкова audit-query
І нарешті я б зробив окремий health-check, який можна запускати регулярно.
WITH base AS (

    SELECT
        event_name,
        customer_user_id,
        appsflyer_id,

        CONCAT(
            IFNULL(SAFE_CAST(customer_user_id AS STRING),''),
            '-',
            IFNULL(SAFE_CAST(appsflyer_id AS STRING),'')
        ) AS combined_id

    FROM `appsflyer.inapps`

    WHERE event_name IN (
        'marketing_sign_contract_open_card_ladna',
        'marketing_activate_credit_limit'
    )
),

cards AS (

    SELECT DISTINCT combined_id
    FROM base
    WHERE event_name =
        'marketing_sign_contract_open_card_ladna'

),

limits AS (

    SELECT DISTINCT combined_id
    FROM base
    WHERE event_name =
        'marketing_activate_credit_limit'

),

checks AS (

    SELECT
        'Card: missing appsflyer_id' AS check_name,
        COUNTIF(appsflyer_id IS NULL) AS affected,
        COUNT(*) AS total

    FROM base

    WHERE event_name =
        'marketing_sign_contract_open_card_ladna'

    UNION ALL

    SELECT
        'Card: missing customer_user_id',
        COUNTIF(customer_user_id IS NULL),
        COUNT(*)

    FROM base

    WHERE event_name =
        'marketing_sign_contract_open_card_ladna'

    UNION ALL

    SELECT
        'Limit: missing appsflyer_id',
        COUNTIF(appsflyer_id IS NULL),
        COUNT(*)

    FROM base

    WHERE event_name =
        'marketing_activate_credit_limit'

    UNION ALL

    SELECT
        'Limit: missing customer_user_id',
        COUNTIF(customer_user_id IS NULL),
        COUNT(*)

    FROM base

    WHERE event_name =
        'marketing_activate_credit_limit'

    UNION ALL

    SELECT
        'Limit without card',
        COUNTIF(c.combined_id IS NULL),
        COUNT(*)

    FROM limits l

    LEFT JOIN cards c
        USING(combined_id)
)

SELECT
    check_name,
    affected,
    total,

    ROUND(
        SAFE_DIVIDE(affected,total) * 100,
        2
    ) AS affected_pct

FROM checks

ORDER BY affected_pct DESC;

