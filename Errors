SELECT
    (
        SELECT up.value.string_value
        FROM UNNEST(user_properties) up
        WHERE up.key = 'oid'
    ) AS oid,

    user_pseudo_id

FROM `project.dataset.events_*`

WHERE _TABLE_SUFFIX = '20261005'
  AND (
        SELECT up.value.string_value
        FROM UNNEST(user_properties) up
        WHERE up.key = 'oid'
      ) IS NOT NULL

LIMIT 100;


SELECT
    event_date,
    event_timestamp,
    event_name,
    user_pseudo_id,

    (
        SELECT up.value.string_value
        FROM UNNEST(user_properties) AS up
        WHERE up.key = 'oid'
    ) AS oid

FROM `project.dataset.events_*`

WHERE _TABLE_SUFFIX BETWEEN '20261001' AND '20261006';


WITH ga4 AS (
    SELECT
        user_pseudo_id,

        (
            SELECT up.value.string_value
            FROM UNNEST(user_properties) up
            WHERE up.key = 'oid'
        ) AS oid

    FROM `project.dataset.events_*`

    WHERE _TABLE_SUFFIX BETWEEN '20261001' AND '20261006'
)

SELECT
    ga4.user_pseudo_id,
    ga4.oid,
    af.appsflyer_id,
    af.customer_user_id,
    af.event_name

FROM ga4

LEFT JOIN `your_appsflyer_table` af
    ON ga4.oid = af.af_sub3;
