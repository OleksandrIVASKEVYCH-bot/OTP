# =========================================================
# ENSURE BIGQUERY TABLE
# =========================================================

def ensure_facebook_table():

    try:

        bigquery_client.get_table(
            TABLE_REF
        )

        logger.info(
            f"Table already exists: {TABLE_REF}"
        )

    except NotFound:

        logger.info(
            f"Creating table: {TABLE_REF}"
        )

        table = bigquery.Table(
            TABLE_REF,
            schema=schema_facebook_stat
        )

        table.time_partitioning = (
            bigquery.TimePartitioning(
                type_=bigquery.TimePartitioningType.DAY,
                field="date"
            )
        )

        table.clustering_fields = [
            "account_id",
            "campaign_id"
        ]

        bigquery_client.create_table(
            table
        )

        logger.info(
            f"Table created: {TABLE_REF}"
        )

    return TABLE_REF


# =========================================================
# LOAD META FOR ONE DAY
# =========================================================

def load_meta_ads_one_day(
    account_ids,
    current_date
):

    fields = [

        AdsInsights.Field.date_start,

        AdsInsights.Field.account_id,

        AdsInsights.Field.ad_id,
        AdsInsights.Field.ad_name,

        AdsInsights.Field.adset_id,
        AdsInsights.Field.adset_name,

        AdsInsights.Field.campaign_id,
        AdsInsights.Field.campaign_name,

        AdsInsights.Field.clicks,
        AdsInsights.Field.impressions,
        AdsInsights.Field.spend,

        AdsInsights.Field.conversions,
        AdsInsights.Field.actions
    ]


    params = {

        "level": "ad",

        "time_range": {
            "since": current_date,
            "until": current_date
        },

        "time_increment": 1,

        "breakdowns": [
            "country"
        ],

        "limit": 500
    }


    rows = []


    for account_id in account_ids:

        clean_account_id = (
            str(account_id)
            .replace(
                "act_",
                ""
            )
        )


        logger.info(
            f"Meta account: {clean_account_id}"
        )


        account = AdAccount(
            f"act_{clean_account_id}"
        )


        insights = account.get_insights(
            fields=fields,
            params=params
        )


        for item in insights:

            rows.append({

                "date":
                    item.get(
                        "date_start"
                    ),

                "account_id":
                    item.get(
                        "account_id",
                        clean_account_id
                    ),

                "ad_id":
                    item.get(
                        "ad_id"
                    ),

                "ad_name":
                    item.get(
                        "ad_name"
                    ),

                "adset_id":
                    item.get(
                        "adset_id"
                    ),

                "adset_name":
                    item.get(
                        "adset_name"
                    ),

                "campaign_id":
                    item.get(
                        "campaign_id"
                    ),

                "campaign_name":
                    item.get(
                        "campaign_name"
                    ),

                "clicks":
                    item.get(
                        "clicks",
                        0
                    ),

                "impressions":
                    item.get(
                        "impressions",
                        0
                    ),

                "spend":
                    item.get(
                        "spend",
                        0
                    ),

                "conversions":
                    item.get(
                        "conversions",
                        []
                    ),

                "actions":
                    item.get(
                        "actions",
                        []
                    ),

                "country":
                    item.get(
                        "country"
                    )
            })


    return pd.DataFrame(
        rows
    )


# =========================================================
# PREPARE DATAFRAME
# =========================================================

def prepare_meta_df(
    df
):

    if df.empty:

        return df


    df = df.copy()


    # DATE
    df["date"] = (
        pd.to_datetime(
            df["date"],
            errors="coerce"
        )
        .dt.date
    )


    # INTEGER
    integer_columns = [

        "account_id",

        "ad_id",

        "adset_id",

        "campaign_id",

        "clicks",

        "impressions"
    ]


    for col in integer_columns:

        df[col] = (
            pd.to_numeric(
                df[col],
                errors="coerce"
            )
            .astype(
                "Int64"
            )
        )


    # FLOAT
    df["spend"] = (
        pd.to_numeric(
            df["spend"],
            errors="coerce"
        )
        .fillna(
            0.0
        )
    )


    # STRING
    string_columns = [

        "ad_name",

        "adset_name",

        "campaign_name",

        "country"
    ]


    for col in string_columns:

        df[col] = (
            df[col]
            .astype(
                "string"
            )
        )


    # ARRAYS
    for col in [

        "actions",

        "conversions"

    ]:

        df[col] = (
            df[col]
            .apply(
                lambda x:
                    x
                    if isinstance(
                        x,
                        list
                    )
                    else []
            )
        )


    return df


# =========================================================
# GET MAX DATE
# =========================================================

def get_max_date():

    query = f"""
        SELECT
            MAX(date) AS max_date
        FROM `{TABLE_REF}`
    """


    result = (
        bigquery_client
        .query(
            query
        )
        .result()
    )


    row = next(
        iter(
            result
        )
    )


    return row.max_date


# =========================================================
# DELETE ONE DAY
# =========================================================

def delete_day_from_bigquery(
    current_date
):

    query = f"""
        DELETE FROM `{TABLE_REF}`
        WHERE date = @current_date
    """


    job_config = (
        bigquery.QueryJobConfig(

            query_parameters=[

                bigquery.ScalarQueryParameter(
                    "current_date",
                    "DATE",
                    current_date
                )
            ]
        )
    )


    job = (
        bigquery_client
        .query(
            query,
            job_config=job_config
        )
    )


    job.result()


# =========================================================
# UPLOAD ONE DAY
# =========================================================

def upload_day_to_bigquery(
    df
):

    job_config = (
        bigquery.LoadJobConfig(

            schema=schema_facebook_stat,

            write_disposition=(
                bigquery
                .WriteDisposition
                .WRITE_APPEND
            )
        )
    )


    job = (
        bigquery_client
        .load_table_from_dataframe(
            df,
            TABLE_REF,
            job_config=job_config
        )
    )


    job.result()


# =========================================================
# PROCESS ONE DAY
# =========================================================

def process_one_day(
    account_ids,
    current_date
):

    date_str = (
        current_date
        .strftime(
            "%Y-%m-%d"
        )
    )


    logger.info(
        "=" * 60
    )

    logger.info(
        f"Processing: {date_str}"
    )

    logger.info(
        "=" * 60
    )


    # ---------------------------------------------------------
    # 1. DOWNLOAD FROM META
    # ---------------------------------------------------------

    df_day = load_meta_ads_one_day(

        account_ids=account_ids,

        current_date=date_str
    )


    # ---------------------------------------------------------
    # 2. EMPTY RESULT
    # ---------------------------------------------------------

    if df_day.empty:

        logger.info(
            f"No Meta data for {date_str}"
        )

        return {
            "date": date_str,
            "rows": 0,
            "status": "empty"
        }


    # ---------------------------------------------------------
    # 3. PREPARE TYPES
    # ---------------------------------------------------------

    df_day = prepare_meta_df(
        df_day
    )


    logger.info(
        f"Rows: {len(df_day):,}"
    )


    logger.info(
        f"Accounts: "
        f"{df_day['account_id'].nunique():,}"
    )


    logger.info(
        f"Campaigns: "
        f"{df_day['campaign_id'].nunique():,}"
    )


    logger.info(
        f"Adsets: "
        f"{df_day['adset_id'].nunique():,}"
    )


    logger.info(
        f"Ads: "
        f"{df_day['ad_id'].nunique():,}"
    )


    logger.info(
        f"Spend: "
        f"{df_day['spend'].sum():,.2f}"
    )


    # ---------------------------------------------------------
    # 4. DELETE OLD VERSION
    # ---------------------------------------------------------

    delete_day_from_bigquery(
        current_date
    )


    logger.info(
        f"Deleted old data: {date_str}"
    )


    # ---------------------------------------------------------
    # 5. UPLOAD NEW VERSION
    # ---------------------------------------------------------

    upload_day_to_bigquery(
        df_day
    )


    logger.info(
        f"Uploaded {len(df_day):,} rows"
    )


    logger.info(
        f"Completed: {date_str}"
    )


    return {

        "date":
            date_str,

        "rows":
            len(
                df_day
            ),

        "status":
            "success"
    }


# =========================================================
# MAIN UPDATE
# =========================================================

def update_meta_table(

    account_ids=ACCOUNT_IDS,

    fallback_date_from=FALLBACK_DATE_FROM,

    lookback_days=LOOKBACK_DAYS

):


    ensure_facebook_table()


    max_date = get_max_date()


    # ---------------------------------------------------------
    # START DATE
    # ---------------------------------------------------------

    if max_date is None:

        reload_from = (
            datetime.strptime(
                fallback_date_from,
                "%Y-%m-%d"
            )
            .date()
        )


    else:

        reload_from = (

            max_date

            - timedelta(
                days=lookback_days
            )
        )


    # ---------------------------------------------------------
    # END DATE
    # Europe/Kyiv instead of UTC
    # ---------------------------------------------------------

    reload_to = (
        datetime.now(
            KYIV_TZ
        )
        .date()
    )


    logger.info(
        "=" * 60
    )


    logger.info(
        f"MAX date in BigQuery: {max_date}"
    )


    logger.info(
        f"Refresh period: "
        f"{reload_from} -> {reload_to}"
    )


    logger.info(
        "=" * 60
    )


    # ---------------------------------------------------------
    # LOOP
    # ---------------------------------------------------------

    current_date = reload_from


    results = []


    while current_date <= reload_to:

        try:

            result = process_one_day(

                account_ids=account_ids,

                current_date=current_date
            )


            results.append(
                result
            )


        except Exception as e:

            logger.exception(

                f"ERROR processing "
                f"{current_date}: {e}"
            )


            raise


        current_date += timedelta(
            days=1
        )


    logger.info(
        "=" * 60
    )

    logger.info(
        "Meta table update completed"
    )

    logger.info(
        "=" * 60
    )


    return results


# =========================================================
# CLOUD FUNCTION HTTP ENTRYPOINT
# =========================================================

@functions_framework.http
def meta_etl(
    request
):

    logger.info(
        "Meta ETL HTTP request received"
    )


    try:

        results = update_meta_table()


        total_rows = sum(

            x.get(
                "rows",
                0
            )

            for x in results
        )


        return {

            "status":
                "success",

            "days_processed":
                len(
                    results
                ),

            "rows_uploaded":
                total_rows,

            "details":
                results

        }, 200


    except Exception as e:

        logger.exception(
            "Meta ETL failed"
        )


        return {

            "status":
                "error",

            "error_type":
                type(e).__name__,

            "error":
                str(e)

        }, 500
