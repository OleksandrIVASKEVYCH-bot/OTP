CREATE OR REPLACE TABLE
  `crested-aquifer-142707.IOV_silver.landing`
PARTITION BY DATE(event_datetime)
AS

WITH extracted_events AS (
  SELECT
    TIMESTAMP_MICROS(event_timestamp) AS event_datetime,

    COALESCE(user_id, user_pseudo_id) AS user_id,

    (
      SELECT ep.value.string_value
      FROM UNNEST(event_params) AS ep
      WHERE ep.key = 'page_location'
    ) AS page_location,

    (
      SELECT ep.value.string_value
      FROM UNNEST(event_params) AS ep
      WHERE ep.key = 'click_text'
    ) AS click_text,

    (
      SELECT ep.value.string_value
      FROM UNNEST(event_params) AS ep
      WHERE ep.key = 'click_url'
    ) AS click_url,

    (
      SELECT ep.value.string_value
      FROM UNNEST(event_params) AS ep
      WHERE ep.key = 'click_hostname'
    ) AS click_hostname

  FROM
    `crested-aquifer-142707.analytics_250473208.events_*`

  WHERE
    _TABLE_SUFFIX BETWEEN '20260801'
      AND FORMAT_DATE('%Y%m%d', CURRENT_DATE('UTC'))
    AND event_name = 'all_click_site'
)

SELECT
  event_datetime,
  user_id,
  page_location,
  click_text,
  click_url,
  click_hostname
FROM extracted_events
WHERE page_location LIKE '%/landing_page/cash-loan/%';
