config {
  type: "table",
  bigquery: {
    partitionBy: "key_event_date"
  },
  description: "GA4 attribution staging table"
}

WITH base_events AS (

  SELECT
    -- Event
    event_date,
    event_timestamp,
    event_name,
    user_pseudo_id,

    -- Session
    (
      SELECT value.int_value
      FROM UNNEST(event_params)
      WHERE key = 'ga_session_id'
    ) AS ga_session_id,

    -- Page
    (
      SELECT value.string_value
      FROM UNNEST(event_params)
      WHERE key = 'page_location'
    ) AS page_location,

    -- Transaction
    (
      SELECT value.string_value
      FROM UNNEST(event_params)
      WHERE key = 'transaction_id'
    ) AS transaction_id,

    -- Manual UTM / collected traffic source
    collected_traffic_source.manual_source AS manual_source,
    collected_traffic_source.manual_medium AS manual_medium,
    collected_traffic_source.manual_campaign_name AS manual_campaign_name,

    -- Click IDs
    collected_traffic_source.gclid AS gclid,
    collected_traffic_source.dclid AS dclid,

    -- First user acquisition
    traffic_source.source AS first_user_source,
    traffic_source.medium AS first_user_medium,
    traffic_source.name AS first_user_campaign

  FROM ${ref("raw_ga4_data")}

),

/* ---------------------------------------------------------
   1. SESSION ID
--------------------------------------------------------- */

events AS (

  SELECT
    *,

    CONCAT(
      user_pseudo_id,
      '-',
      CAST(ga_session_id AS STRING)
    ) AS session_id

  FROM base_events

  WHERE user_pseudo_id IS NOT NULL
),

/* ---------------------------------------------------------
   2. SESSION LANDING PAGE
--------------------------------------------------------- */

session_data AS (

  SELECT
    user_pseudo_id,
    session_id,

    MIN(event_timestamp) AS session_start_timestamp,

    ARRAY_AGG(
      page_location
      IGNORE NULLS
      ORDER BY event_timestamp
      LIMIT 1
    )[SAFE_OFFSET(0)] AS landing_page,

    ARRAY_AGG(
      manual_source
      IGNORE NULLS
      ORDER BY event_timestamp
      LIMIT 1
    )[SAFE_OFFSET(0)] AS manual_source,

    ARRAY_AGG(
      manual_medium
      IGNORE NULLS
      ORDER BY event_timestamp
      LIMIT 1
    )[SAFE_OFFSET(0)] AS manual_medium,

    ARRAY_AGG(
      manual_campaign_name
      IGNORE NULLS
      ORDER BY event_timestamp
      LIMIT 1
    )[SAFE_OFFSET(0)] AS manual_campaign_name,

    ARRAY_AGG(
      gclid
      IGNORE NULLS
      ORDER BY event_timestamp
      LIMIT 1
    )[SAFE_OFFSET(0)] AS gclid,

    ARRAY_AGG(
      dclid
      IGNORE NULLS
      ORDER BY event_timestamp
      LIMIT 1
    )[SAFE_OFFSET(0)] AS dclid

  FROM events

  WHERE session_id IS NOT NULL

  GROUP BY
    user_pseudo_id,
    session_id
),

/* ---------------------------------------------------------
   3. BUILD ATTRIBUTION SEGMENTS
--------------------------------------------------------- */

segments AS (

  SELECT
    user_pseudo_id,
    session_id,

    session_start_timestamp AS segment_timestamp,

    DATE(
      TIMESTAMP_MICROS(session_start_timestamp)
    ) AS segment_date,

    ROW_NUMBER() OVER (
      PARTITION BY user_pseudo_id
      ORDER BY session_start_timestamp
    ) AS segment_number,

    landing_page,

    manual_source,
    manual_medium,
    manual_campaign_name,

    gclid,
    dclid

  FROM session_data
),

/* ---------------------------------------------------------
   4. SOURCE NORMALIZATION

   Тут краще згодом винести source_id у DIM_SOURCE.
--------------------------------------------------------- */

segments_with_source AS (

  SELECT
    *,

    CONCAT(
      COALESCE(manual_source, '(direct)'),
      ' / ',
      COALESCE(manual_medium, '(none)')
    ) AS source_id,

    TO_HEX(
      MD5(
        COALESCE(landing_page, '')
      )
    ) AS landing_page_id,

    CONCAT(
      user_pseudo_id,
      '-',
      CAST(segment_number AS STRING)
    ) AS segment_id

  FROM segments
),

/* ---------------------------------------------------------
   5. KEY EVENTS
--------------------------------------------------------- */

key_events AS (

  SELECT
    CONCAT(
      user_pseudo_id,
      '-',
      CAST(event_timestamp AS STRING),
      '-',
      event_name
    ) AS key_event_id,

    event_name AS key_event_name,

    user_pseudo_id,

    event_timestamp AS key_event_timestamp,

    DATE(
      TIMESTAMP_MICROS(event_timestamp)
    ) AS key_event_date

  FROM events

  WHERE event_name IN (
    'purchase'
    -- сюди додаємо інші key events
    -- 'generate_lead',
    -- 'sign_up'
  )
),

/* ---------------------------------------------------------
   6. CONNECT ALL PREVIOUS TOUCHPOINTS TO CONVERSION
--------------------------------------------------------- */

attribution AS (

  SELECT
    k.key_event_id,
    k.key_event_name,
    k.user_pseudo_id,

    s.session_id,
    s.segment_id,
    s.segment_timestamp,

    k.key_event_timestamp,

    s.segment_date,
    k.key_event_date,

    DATE_DIFF(
      k.key_event_date,
      s.segment_date,
      DAY
    ) AS days_before_key_event,

    s.landing_page_id,
    s.source_id

  FROM key_events k

  INNER JOIN segments_with_source s

    ON k.user_pseudo_id = s.user_pseudo_id

    -- segment має відбутися ДО conversion
    AND s.segment_timestamp <= k.key_event_timestamp

    -- attribution window
    AND DATE_DIFF(
          k.key_event_date,
          s.segment_date,
          DAY
        ) BETWEEN 0 AND 30
)

SELECT
  key_event_id,
  key_event_name,
  user_pseudo_id,
  session_id,
  segment_id,
  segment_timestamp,
  key_event_timestamp,
  segment_date,
  key_event_date,
  days_before_key_event,
  landing_page_id,
  source_id

FROM attribution
