WITH events AS (
    SELECT
        appsflyer_id,
        LOGICAL_OR(
            event_name = 'marketing_sign_contract_open_card_ladna'
        ) AS marketing_sign_contract_open_card_ladna,
        LOGICAL_OR(
            event_name = 'marketing_sign_contract_cashloan'
        ) AS marketing_sign_contract_cashloan,
        LOGICAL_OR(
            event_name = 'marketing_cash_loan_offer_view'
        ) AS marketing_cash_loan_offer_view,
        LOGICAL_OR(
            event_name = 'marketing_activate_credit_limit'
        ) AS marketing_activate_credit_limit
    FROM `appsflyer.inapps`
    WHERE event_name IN (
        'marketing_sign_contract_open_card_ladna',
        'marketing_sign_contract_cashloan',
        'marketing_cash_loan_offer_view',
        'marketing_activate_credit_limit'
    )
    GROUP BY appsflyer_id
),

preparation_data AS (
    SELECT DISTINCT
        appsflyer_id,
        COALESCE(customer_user_id, appsflyer_id) AS user_id,
        CAST(install_time AS DATETIME) AS install_date,
        media_source,
        platform,
        campaign,
        CASE
            WHEN campaign LIKE '%_nb%' THEN 'Nishchuk'
            WHEN campaign LIKE '%_az' THEN 'Zmiienko'
            ELSE 'other'
        END AS responsible_marketing_manager,
        af_ad_id AS creative_id,
        af_ad AS creative_name
    FROM `appsflyer.installs`
),

installs AS (
    SELECT
        user_id,
        appsflyer_id,
        CAST(install_date AS DATE) AS install_date,
        media_source,
        platform,
        campaign,
        responsible_marketing_manager,
        creative_id,
        creative_name,
        COUNT(appsflyer_id) AS installs
    FROM preparation_data
    GROUP BY 1, 2, 3, 4, 5, 6, 7, 8, 9
)

SELECT
    COALESCE(i.user_id, e.appsflyer_id) AS user_id,
    COALESCE(i.appsflyer_id, e.appsflyer_id) AS appsflyer_id,
    i.install_date,
    i.media_source,
    i.platform,
    i.campaign,
    i.responsible_marketing_manager,
    i.creative_id,
    i.creative_name,
    COALESCE(i.installs, 0) AS installs,
    COALESCE(e.marketing_sign_contract_open_card_ladna, FALSE)
        AS marketing_sign_contract_open_card_ladna,
    COALESCE(e.marketing_activate_credit_limit, FALSE)
        AS marketing_activate_credit_limit,
    COALESCE(e.marketing_sign_contract_cashloan, FALSE)
        AS marketing_sign_contract_cashloan,
    COALESCE(e.marketing_cash_loan_offer_view, FALSE)
        AS marketing_cash_loan_offer_view
FROM installs AS i
FULL OUTER JOIN events AS e
    ON i.appsflyer_id = e.appsflyer_id;
