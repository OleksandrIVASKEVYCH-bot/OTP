SELECT
    TIMESTAMP_MICROS(event_timestamp) AS event_datetime,

    user_id,
    user_pseudo_id,

    (
        SELECT value.int_value
        FROM UNNEST(event_params)
        WHERE key = 'ga_session_id'
    ) AS ga_session_id,

    (
        SELECT value.string_value
        FROM UNNEST(event_params)
        WHERE key = 'page_location'
    ) AS page_location,

    (
        SELECT value.string_value
        FROM UNNEST(event_params)
        WHERE key = 'click_text'
    ) AS click_text,

    (
        SELECT value.string_value
        FROM UNNEST(event_params)
        WHERE key = 'click_url'
    ) AS click_url,

    (
        SELECT value.string_value
        FROM UNNEST(event_params)
        WHERE key = 'click_hostname'
    ) AS click_hostname

FROM `PROJECT.DATASET.events_*`

WHERE _TABLE_SUFFIX BETWEEN '20260901' AND '20260925'
  AND event_name = 'all_click_site'
  AND (
        SELECT value.string_value
        FROM UNNEST(event_params)
        WHERE key = 'page_location'
      ) LIKE '%/landing_page/cash-loan/%'

ORDER BY event_timestamp DESC

LIMIT 1000;
